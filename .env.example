# SportBrief - Configuration API
# Copiez ce fichier vers .env et remplissez vos clés

# Football-data.org
# Inscription gratuite: https://www.football-data.org/
FOOTBALL_DATA_ORG_KEY=your_football_data_key_here

# Google Gemini
# Créer une clé: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
