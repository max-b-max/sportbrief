# SportBrief - Configuration API
# Copiez ce fichier vers .env et remplissez vos clés

# API-Sports (api-football.com, api-basketball.com, etc.)
# Inscription gratuite: https://www.api-football.com/
# Note: le plan gratuit est limité à 100 requêtes/jour
API_SPORTS_KEY=your_api_sports_key_here

# Football-data.org
# Inscription gratuite: https://www.football-data.org/
FOOTBALL_DATA_ORG_KEY=your_football_data_key_here

# Google Gemini
# Créer une clé: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sportradar (optionnel - pour tennis, pingpong)
# SPORTRADAR_API_KEY=your_sportradar_key_here
