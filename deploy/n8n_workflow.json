{
  "name": "SportBrief - Briefing Quotidien",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Declencheur 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sportbrief-manual",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Manuel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 500],
      "webhookId": "sportbrief-manual"
    },
    {
      "parameters": {
        "command": "cd /home/ubuntu/sportbrief && . venv/bin/activate && python sportbrief.py -a 2>&1"
      },
      "id": "execute-pipeline",
      "name": "Executer Pipeline",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [500, 400],
      "credentials": {
        "sshPassword": {
          "id": "create",
          "name": "SSH SportBrief Local"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.code }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-result",
      "name": "Verifier Resultat",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "success-msg",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $now.format('dd/MM/yyyy HH:mm') }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Briefing SportBrief genere avec succes",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "success-output",
      "name": "Succes",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error-msg",
              "name": "status",
              "value": "error",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $now.format('dd/MM/yyyy HH:mm') }}",
              "type": "string"
            },
            {
              "id": "error-details",
              "name": "error",
              "value": "={{ $json.stderr || $json.stdout }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "error-output",
      "name": "Erreur",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 500]
    }
  ],
  "connections": {
    "Declencheur 7h": {
      "main": [
        [
          {
            "node": "Executer Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Manuel": {
      "main": [
        [
          {
            "node": "Executer Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Executer Pipeline": {
      "main": [
        [
          {
            "node": "Verifier Resultat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verifier Resultat": {
      "main": [
        [
          {
            "node": "Succes",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Erreur",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Europe/Paris"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 2,
  "versionId": "4"
}
